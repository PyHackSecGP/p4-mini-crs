[Unit]
Description=P4 Mini-CRS auto-pipeline inotify watcher
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/p4-mini-crs
EnvironmentFile=%h/projects/p4-mini-crs/auto/.env
ExecStart=/bin/bash -c 'source venv/bin/activate 2>/dev/null; exec python3 auto/watcher.py'
Restart=on-failure
RestartSec=15s
StandardOutput=append:%h/projects/p4-mini-crs/auto/logs/watcher.log
StandardError=append:%h/projects/p4-mini-crs/auto/logs/watcher.log

[Install]
WantedBy=default.target
